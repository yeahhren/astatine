set(content "#define EMBEDDED_SHADERS_H\n")
set(table "")
foreach (name IN LISTS NAMES)
    file(READ "${DIRECTORY}/${name}.spv" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR words "${length} / 8")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1u," body "${hex}")
    string(APPEND content "static const uint32_t shader_${name}[] = {${body}};\n")
    string(APPEND table "    {\"${name}\", shader_${name}, ${words}},\n")
endforeach ()
string(APPEND content "static const EmbeddedShader EMBEDDED_SHADERS[] = {\n${table}};\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
